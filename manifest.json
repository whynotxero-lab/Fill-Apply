{
  "manifest_version": 3,
  "name": "Fill & Apply",
  "version": "1.1.0",
  "description": "Queue-driven job-application filler with ATS adapters and a generic fallback.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Fill & Apply",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["demo/sample-application.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
