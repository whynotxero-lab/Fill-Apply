{
  "manifest_version": 3,
  "name": "Fill & Apply",
  "version": "1.10.0",
  "description": "Queue-driven job-application filler with multi-profile Options + universal Apply-start (Apply / Apply Now / Start Apply / Apply for this Job opens the form) + Teamtailor ATS (modal apply) + Zahid General + high-alert pause when a required field is blank: Recruitee\u2192Indeed, eFinancialCareers, LinkedIn Easy/External Apply\u2192iCIMS, Jooble\u2192Swooped, WWR\u2192CATS, Ashby caps, PDF reports, fill/ready/submit.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "sidePanel",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "action": {
    "default_title": "Fill & Apply",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "demo/sample-application.html",
        "demo/sample-application.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
